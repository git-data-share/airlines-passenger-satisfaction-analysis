table _measures
	lineageTag: c3e12a69-2477-4e44-9c62-b70424de5161

	measure 'Total Passengers' =
			
			COUNTROWS(Fact_Satisfaction)
		formatString: #,0
		lineageTag: 9a85a1f8-38b3-400b-8cdc-a92e8058961f

	measure 'Total Satisfied' =
			
			COUNTROWS(
			    FILTER(Fact_Satisfaction,
			    Fact_Satisfaction[Satisfaction] = "Satisfied")
			)
		formatString: 0
		lineageTag: 0c6c8f39-aa7f-4ae7-b624-e77e3979e1db

	measure 'Total Dissatisfied' =
			
			COUNTROWS(
			    FILTER(Fact_Satisfaction,
			    Fact_Satisfaction[Satisfaction] = "Neutral or Dissatisfied")
			)
		formatString: 0
		lineageTag: 386030f2-678a-4261-aa33-30e69511cc2d

	measure 'Satisfaction Rate %' =
			
			DIVIDE([Total Satisfied], [Total Passengers], 0)
		formatString: 0%;-0%;0%
		lineageTag: 48abd63c-b165-4ea2-95fc-8dffd37ce20d

	measure 'Dissatisfaction Rate %' = ```
			
			DIVIDE([Total Dissatisfied], [Total Passengers], 0) 
			```
		formatString: 0%;-0%;0%
		lineageTag: 970fccea-b0c9-404c-b8c8-e9c40a2eb0e8

	measure 'First Time Passengers' =
			
			COUNTROWS(
			    FILTER(Fact_Satisfaction,
			    Fact_Satisfaction[Customer_Type] = "First-time")
			)
		formatString: #,0
		lineageTag: e8f04044-cb71-4c6f-9ea4-c64c8237ee1e

	measure 'Returning Passengers' =
			
			COUNTROWS(
			    FILTER(Fact_Satisfaction,
			    Fact_Satisfaction[Customer_Type] = "Returning")
			)
		formatString: #,0
		lineageTag: 35b2942c-b732-45a5-a145-8a822b1e22b5

	measure 'First Time %' =
			
			DIVIDE([First Time Passengers], [Total Passengers], 0)
		formatString: 0%;-0%;0%
		lineageTag: edb1c1be-cd1f-4373-8644-f2ddbcb2ddba

	measure 'Returning %' = ```
			
			DIVIDE([Returning Passengers], [Total Passengers], 0) 
			```
		formatString: 0%;-0%;0%
		lineageTag: 8bd4d384-6365-4a71-aff4-676da6604087

	measure 'Male Passengers %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			    Fact_Satisfaction[Gender] = "Male")),
			    [Total Passengers], 0
			) * 100
		lineageTag: efcadc63-2dab-4467-9d2f-462bf46df648

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Female Passengers %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			    Fact_Satisfaction[Gender] = "Female")),
			    [Total Passengers], 0
			) * 100
		lineageTag: 9737553b-cd96-43a5-97b7-f5a947e7c942

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Flight Distance' =
			
			AVERAGE(Fact_Satisfaction[Flight_Distance])
		lineageTag: 5d00b6fd-79d7-4d47-b86a-9bb62e4c4b46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Departure Delay' =
			
			AVERAGE(Fact_Satisfaction[Departure_Delay])
