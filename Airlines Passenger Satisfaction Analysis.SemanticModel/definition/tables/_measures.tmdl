	measure '% Low Ratings by Service' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(Fact_Survey_Ratings),
			        Fact_Survey_Ratings[Rating] <= 2
			    ),
			    CALCULATE(
			        COUNTROWS(Fact_Survey_Ratings),
			        ALL(Fact_Survey_Ratings[Rating])
			    ),
			    0
			)
		formatString: 0%;-0%;0%
