	measure 'Avg Service Rating' =
			
			AVERAGE(Fact_Survey_Ratings[Rating])
		lineageTag: fd38042d-4631-46cf-8e76-f6aa746f6908

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Wifi Rating' =
			
			CALCULATE(
			    AVERAGE(Fact_Survey_Ratings[Rating]),
			    Fact_Survey_Ratings[Service_Name] = "Inflight_Wifi"
			)
		lineageTag: 02fbe50f-86c6-4f20-9fc5-b5a442125272

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Gate Location Rating' =
			
			CALCULATE(
			    AVERAGE(Fact_Survey_Ratings[Rating]),
			    Fact_Survey_Ratings[Service_Name] = "Gate_Location"
			)
		lineageTag: 79c8f550-6aa8-4adf-bc57-7f67c377858b

