	measure 'Personal Travel Dissatisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Type_of_Travel] = "Personal" &&
			        Fact_Satisfaction[Satisfaction] = "Neutral or Dissatisfied")),
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Type_of_Travel] = "Personal")),
			    0
			) * 100
		lineageTag: 257a5e73-3cc8-4306-b466-23adfc54b568

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Economy Dissatisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Class] = "Economy" &&
			        Fact_Satisfaction[Satisfaction] = "Neutral or Dissatisfied")),
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Class] = "Economy")),
			    0
			) * 100
		lineageTag: b14a8261-f5e1-417b-8510-ce34fdb2097a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'First Time Dissatisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Customer_Type] = "First-time" &&
			        Fact_Satisfaction[Satisfaction] = "Neutral or Dissatisfied")),
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Customer_Type] = "First-time")),
			    0
			) * 100
		lineageTag: 47263429-b3e9-476d-b300-ac7b97deff3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Senior Dissatisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Age_Group] = "65+" &&
			        Fact_Satisfaction[Satisfaction] = "Neutral or Dissatisfied")),
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Age_Group] = "65+")),
			    0
			) * 100
		lineageTag: 0dd4488f-cb7c-4f87-b5ef-43b7872031ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Short Haul Dissatisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Flight_Distance_Group] = "Short Haul" &&
