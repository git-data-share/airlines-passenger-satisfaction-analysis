	measure 'Avg Online Booking Rating' =
			
			CALCULATE(
			    AVERAGE(Fact_Survey_Ratings[Rating]),
			    Fact_Survey_Ratings[Service_Name] = "Ease_of_Online_Booking"
			)
		lineageTag: d5e5f0cc-5fe6-423d-ac89-998bb1aa2238

