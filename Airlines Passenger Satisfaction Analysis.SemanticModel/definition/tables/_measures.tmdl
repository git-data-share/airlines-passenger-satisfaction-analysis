	measure '% Low Ratings' = ```
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Survey_Ratings,
			    Fact_Survey_Ratings[Rating] <= 2)),
			    COUNTROWS(Fact_Survey_Ratings),
			    0
			) 
			```
		formatString: 0%;-0%;0%
		lineageTag: cd5cda53-d5ad-4d90-bd3a-114298624433

	measure '% High Ratings' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Survey_Ratings,
			    Fact_Survey_Ratings[Rating] >= 4)),
			    COUNTROWS(Fact_Survey_Ratings),
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: c1218aa5-5318-40a9-8c48-6009ceb40f31

	measure 'Avg Pre-Boarding' =
			
			CALCULATE(
			    AVERAGE(Fact_Survey_Ratings[Rating]),
			    Fact_Survey_Ratings[Service_Category] = "Pre-Boarding"
			)
		lineageTag: e4f3fb20-bd30-40eb-bd41-b6653f34c2fc

