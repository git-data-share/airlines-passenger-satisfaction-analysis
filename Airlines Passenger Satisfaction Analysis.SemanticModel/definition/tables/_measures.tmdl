	measure 'Economy Plus Dissatisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Class] = "Economy Plus" &&
			        Fact_Satisfaction[Satisfaction] = "Neutral or Dissatisfied")),
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Class] = "Economy Plus")),
			    0
			) * 100
		lineageTag: 900747d5-106f-423e-a277-151b463b8332

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No Delay Satisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Departure_Delay] = 0 &&
			        Fact_Satisfaction[Satisfaction] = "Satisfied")),
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Departure_Delay] = 0)),
			    0
			) * 100
		lineageTag: f2fccee7-67aa-416f-a9f0-6b258d8d59b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Business Satisfied %' =
			
			DIVIDE(
			    COUNTROWS(FILTER(Fact_Satisfaction,
			        Fact_Satisfaction[Class] = "Business" &&
